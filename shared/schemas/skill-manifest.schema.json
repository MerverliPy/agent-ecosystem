{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-ecosystem.local/schemas/skill-manifest-v1.schema.json",
  "title": "SkillManifestV1",
  "description": "skillhub.json — a distributable agent skill manifest (spec: shared/specs/skill-manifest-spec-v1.md).",
  "type": "object",
  "required": ["name", "version", "description", "license", "repo", "harnesses"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$",
      "description": "owner/name, lowercase"
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 200 },
    "license": {
      "type": "string",
      "enum": ["MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC", "MIT-0", "Zlib", "Unlicense", "CC0-1.0", "MPL-2.0"]
    },
    "repo": { "type": "string", "minLength": 1 },
    "harnesses": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["claude-code", "codex", "cursor", "gemini-cli", "copilot", "pi", "openclaw"] }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$" },
          "version": { "type": "string", "pattern": "^\\^?[0-9]+\\.[0-9]+\\.[0-9]+$" }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": { "enum": ["files.read", "files.write", "shell", "network", "secrets", "browser"] }
    },
    "entrypoint": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
