{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-ecosystem.local/schemas/benchmark-result-v1.schema.json",
  "title": "BenchmarkResultV1",
  "description": "One measured (or source-attributed) local-inference benchmark row. DRAFT v1 — finalized in Phase 2. DEC-0006: every row must carry an attributable source_url.",
  "type": "object",
  "required": [
    "model", "hardware", "runtime", "tokens_per_sec", "peak_ram_gb",
    "source_url", "submitted_at"
  ],
  "properties": {
    "model": {
      "type": "string",
      "description": "Model identifier, e.g. 'Kimi K3 2.78T' or 'Gemma 4 26B-A4B'"
    },
    "hardware": {
      "type": "object",
      "required": ["cpu"],
      "properties": {
        "cpu": { "type": "string", "description": "e.g. 'Apple M3' / 'Ryzen 9 7950X'" },
        "gpu": { "type": ["string", "null"], "description": "e.g. 'Apple Metal' / 'RTX 4090' / null for CPU-only" },
        "ram_gb": { "type": "number", "description": "Total system RAM in GB" },
        "os": { "type": "string", "description": "e.g. 'macOS 15' / 'Windows 11' / 'Ubuntu 24.04'" }
      }
    },
    "runtime": {
      "type": "string",
      "description": "e.g. 'llama.cpp', 'Ollama', 'turbo-fieldfare', 'kimi-k3-in-c', 'warp', 'vLLM'"
    },
    "quantization": {
      "type": ["string", "null"],
      "description": "e.g. 'MXFP4', 'Q4_K_M', 'int8', null when not quantized"
    },
    "tokens_per_sec": { "type": "number", "exclusiveMinimum": 0 },
    "peak_ram_gb": { "type": "number", "exclusiveMinimum": 0 },
    "disk_size_gb": { "type": ["number", "null"], "description": "Model size on disk (GB)" },
    "active_params_b": {
      "type": ["number", "null"],
      "description": "Active params in billions per token (MoE), e.g. 104 for Kimi K3"
    },
    "quality_delta": {
      "type": ["number", "null"],
      "description": "Quantization quality loss vs unquantized, as relative error % (e.g. int4 ≈ 17%)"
    },
    "fits": {
      "type": ["string", "null"],
      "enum": ["fits", "streams-needed", "no-fit", null],
      "description": "Verdict per the will-it-run calculator; null when unassessed"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "description": "Attributable source: repo README, paper, or runner log (DEC-0006)"
    },
    "submitted_at": { "type": "string", "format": "date-time" }
  }
}
