#!/usr/bin/env bash
# Pre-push guard: never push a PHASES.md that drifted from its PLAN.lock without the approval token.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
zero="0000000000000000000000000000000000000000"
while read -r _local_ref _local_sha remote_ref remote_sha; do
  if [ "$remote_sha" = "$zero" ]; then
    continue  # new branch with no remote history — push itself is checked by pre-commit locally
  fi
  if git diff --name-only "$remote_sha..$_local_sha" | grep -qE '^(PHASES\.md|PLAN\.lock)$'; then
    bash "$ROOT/scripts/plan-lock.sh" check-push "$_local_sha" || exit 1
  fi
done
